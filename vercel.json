
{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/product/:slug",
      "destination": "/product/index.html"
    },
    {
      "source": "/product/:slug/",
      "destination": "/product/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/article.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/article.html"
    }
  ]
}
